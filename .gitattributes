###############################################################################
# Line endings
###############################################################################
# Normalize all text files to LF in the repository
* text=auto

# Windows-only sources keep CRLF in the working tree
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Unix shell scripts must stay LF
*.sh    text eol=lf
*.bash  text eol=lf
*.zsh   text eol=lf

