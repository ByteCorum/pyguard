###############################################################################
# Language statistics
###############################################################################
# Force explicit language classification for ambiguous extensions
*.h     linguist-language=C
*.ino   linguist-language=C++
*.cshtml linguist-language=HTML
*.svg   linguist-language=XML

# Make data/config languages count toward statistics
*.sql   linguist-detectable=true
*.yaml  linguist-detectable=true
*.markdown linguist-detectable=true

###############################################################################
# export-ignore - excluded from `git archive` release tarballs
